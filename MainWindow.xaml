<Window x:Class="BankStatementViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BankStatementViewer.ViewModels"
        Title="نمایش‌دهنده و فیلتر گردش حساب بانکی" Height="800" Width="1300" WindowState="Maximized"
        MinHeight="550" MinWidth="800" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" FontFamily="{Binding FontFamilyName}" FontSize="{Binding DisplayFontSize}"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="MainWindow_Loaded"
        xml:lang="fa-IR">
    <Window.Resources>
        <!-- Filter panels stay white when inactive and become green-tinted when their filter is active. -->
        <Style x:Key="FilterGroupBoxStyle" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ActiveFilterBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ActiveFilterBorderBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="AccountInfoPanel" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,0">
                    <TextBlock Text="نام صاحب حساب" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.CustomerName, TargetNullValue=—}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0">
                    <TextBlock Text="شماره شبا" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.Iban, TargetNullValue=—}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0">
                    <TextBlock Text="کد شعبه" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.BranchCode, TargetNullValue=—}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,0">
                    <TextBlock Text="بازه گزارش" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.ReportPeriod, TargetNullValue=—}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,10,4,0">
                    <TextBlock Text="تاریخ دریافت" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.ReceivedDate, TargetNullValue=—}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,10,4,0">
                    <TextBlock Text="مانده آغازین" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.OpeningBalance, StringFormat={}{0:N0}, TargetNullValue=—}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,10,4,0">
                    <TextBlock Text="مانده پایانی" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Header.ClosingBalance, StringFormat={}{0:N0}, TargetNullValue=—}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,10,4,0">
                    <TextBlock Text="فایل فعال" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding CurrentFilePath, TargetNullValue=—}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFilePath}" />
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="1" Margin="0,0,0,6" VerticalAlignment="Center">
            <Image Source="/Agri-bank_logo.png" Width="34" Height="36" Stretch="Uniform" Margin="3,0,7,0" ToolTip="بانک کشاورزی" />
            <Button x:Name="TogglePanelsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8A7;" Click="TogglePanels_Click"
                    ToolTip="مخفی‌کردن فیلترها و مشخصات حساب" AutomationProperties.Name="مخفی‌کردن فیلترها و مشخصات حساب" />
            <Button x:Name="OpenFileButton" Style="{StaticResource IconButtonStyle}" Content="&#xE8E5;" Click="OpenFile_Click"
                    ToolTip="باز کردن صورت‌حساب از فایل‌های رایانه" AutomationProperties.Name="باز کردن صورت‌حساب" />
            <Button x:Name="FullSettingsButton" Style="{StaticResource IconButtonStyle}" Content="&#xE713;" Click="FullSettings_Click"
                    ToolTip="تنظیمات کامل برنامه: چاپ، نمایش، مشخصات شعبه و FTP" AutomationProperties.Name="تنظیمات کامل" />
            <Button x:Name="ReadFtpButton" Style="{StaticResource IconButtonStyle}" Content="&#xE896;" Click="ReadFtp_Click"
                    ToolTip="نمایش فایل‌های موجود در FTP و دریافت صورت‌حساب" AutomationProperties.Name="خواندن از FTP" />
            <Button x:Name="ExportExcelButton" Style="{StaticResource IconButtonStyle}" Content="&#xE9F9;" Click="ExportExcel_Click"
                    ToolTip="ذخیره تراکنش‌های فیلترشده در فایل Excel" AutomationProperties.Name="خروجی Excel" />
            <Button x:Name="PrintPortraitButton" Style="{StaticResource IconButtonStyle}" Content="▯" FontFamily="Segoe UI Symbol" FontSize="22" Click="PrintPortrait_Click"
                    ToolTip="چاپ صورت‌حساب در حالت عمودی" AutomationProperties.Name="چاپ عمودی" />
            <Button x:Name="PrintLandscapeButton" Style="{StaticResource IconButtonStyle}" Content="▱" FontFamily="Segoe UI Symbol" FontSize="22" Click="PrintLandscape_Click"
                    ToolTip="چاپ صورت‌حساب در حالت افقی" AutomationProperties.Name="چاپ افقی" />

            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE9D2;" Click="QuickSummary_Click"
                    ToolTip="نمایش خلاصه کانال‌ها، روزها و تراکنش‌های بزرگ" AutomationProperties.Name="خلاصه سریع" />

            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE894;" Click="ClearFilters_Click"
                    ToolTip="پاک‌کردن همه فیلترهای فعال" AutomationProperties.Name="پاک‌کردن فیلترها" />
            <ProgressBar x:Name="OperationProgressBar" Width="100" Height="10" Margin="6,0,3,0"
                         VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="OperationStatusText" Text="در حال پردازش..." VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="3,0" Visibility="Collapsed" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterColumnDefinition" Width="300" />
                <ColumnDefinition x:Name="SplitterColumnDefinition" Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="FiltersPanel" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,7,0">
                    <GroupBox Header="نوع تراکنش" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.TypeFilterEnabled}">
                        <StackPanel>
                            <CheckBox Content="فعال‌کردن فیلتر نوع" IsChecked="{Binding Filters.TypeFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <RadioButton Content="فقط واریز" Margin="3" IsChecked="{Binding Filters.TypeFilterMode, Converter={x:Static vm:EqualityConverter.Instance}, ConverterParameter=واریز, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.TypeFilterEnabled}" />
                                <RadioButton Content="فقط برداشت" Margin="3" IsChecked="{Binding Filters.TypeFilterMode, Converter={x:Static vm:EqualityConverter.Instance}, ConverterParameter=برداشت, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.TypeFilterEnabled}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="کد شعبه" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.BranchFilterEnabled}">
                        <StackPanel>
                            <CheckBox Content="فیلتر کد شعبه فعال باشد" IsChecked="{Binding Filters.BranchFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Text="{Binding Filters.BranchCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.BranchFilterEnabled}" ToolTip="تطابق دقیق کد شعبه" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="شماره پیگیری" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.TrackingFilterEnabled}">
                        <StackPanel>
                            <CheckBox Content="جستجو در پیگیری و پیگیری واریز" IsChecked="{Binding Filters.TrackingFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Text="{Binding Filters.TrackingText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.TrackingFilterEnabled}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="بازه تاریخ (YYYY/MM/DD)" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.DateFilterEnabled}">
                        <StackPanel>
                            <CheckBox Content="فیلتر بازه تاریخ فعال باشد" IsChecked="{Binding Filters.DateFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid IsEnabled="{Binding Filters.DateFilterEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="از تاریخ" Margin="3,2"/><TextBox Text="{Binding Filters.DateFrom, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="تا تاریخ" Margin="3,2"/><TextBox Text="{Binding Filters.DateTo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="شماره ردیف" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.RowNumberFilterEnabled}">
                        <StackPanel>
                            <CheckBox Content="فیلتر بازه ردیف فعال باشد" IsChecked="{Binding Filters.RowNumberFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid IsEnabled="{Binding Filters.RowNumberFilterEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="از ردیف" Margin="3,2"/><TextBox Text="{Binding Filters.RowFrom, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="تا ردیف" Margin="3,2"/><TextBox Text="{Binding Filters.RowTo, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="مبلغ واریز" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.DepositAmountFilterEnabled}" IsEnabled="{Binding CanUseDepositAmountFilter}">
                        <StackPanel>
                            <CheckBox Content="فیلتر مبلغ واریز فعال باشد" IsChecked="{Binding Filters.DepositAmountFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Filters.DepositAmountMode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.DepositAmountFilterEnabled}">
                                <ComboBoxItem Content="بین دو مبلغ" Tag="Range" />
                                <ComboBoxItem Content="کمتر از مبلغ" Tag="LessThan" />
                                <ComboBoxItem Content="بیشتر از مبلغ" Tag="GreaterThan" />
                            </ComboBox>
                            <Grid IsEnabled="{Binding Filters.DepositAmountFilterEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="مبلغ اول / حد" Margin="3,2"/><TextBox Text="{Binding Filters.DepositAmountFrom, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="مبلغ دوم" Margin="3,2"/><TextBox Text="{Binding Filters.DepositAmountTo, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" IsEnabled="{Binding Filters.DepositAmountMode, Converter={x:Static vm:EqualityConverter.Instance}, ConverterParameter=Range}" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="مبلغ برداشت" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.WithdrawalAmountFilterEnabled}" IsEnabled="{Binding CanUseWithdrawalAmountFilter}">
                        <StackPanel>
                            <CheckBox Content="فیلتر مبلغ برداشت فعال باشد" IsChecked="{Binding Filters.WithdrawalAmountFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Filters.WithdrawalAmountMode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.WithdrawalAmountFilterEnabled}">
                                <ComboBoxItem Content="بین دو مبلغ" Tag="Range" />
                                <ComboBoxItem Content="کمتر از مبلغ" Tag="LessThan" />
                                <ComboBoxItem Content="بیشتر از مبلغ" Tag="GreaterThan" />
                            </ComboBox>
                            <Grid IsEnabled="{Binding Filters.WithdrawalAmountFilterEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="مبلغ اول / حد" Margin="3,2"/><TextBox Text="{Binding Filters.WithdrawalAmountFrom, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="مبلغ دوم" Margin="3,2"/><TextBox Text="{Binding Filters.WithdrawalAmountTo, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" IsEnabled="{Binding Filters.WithdrawalAmountMode, Converter={x:Static vm:EqualityConverter.Instance}, ConverterParameter=Range}" /></StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="جستجوی پیش‌فرض در توضیحات" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.DescriptionFilterEnabled}">
                        <StackPanel>
                            <CheckBox Content="فیلتر توضیحات فعال باشد" IsChecked="{Binding Filters.DescriptionFilterEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox x:Name="PresetCombo" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectionChanged="PresetCombo_SelectionChanged" />
                            <TextBox Text="{Binding Filters.DescriptionSearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.DescriptionFilterEnabled}" />
                            <WrapPanel>
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" Click="AddPreset_Click"
                                        ToolTip="افزودن عبارت جستجو به فهرست پیش‌فرض‌ها" AutomationProperties.Name="افزودن پیش‌فرض" />
                                <Button Style="{StaticResource IconButtonStyle}" Content="&#xE738;" Click="RemovePreset_Click"
                                        ToolTip="حذف پیش‌فرض انتخاب‌شده از فهرست" AutomationProperties.Name="حذف پیش‌فرض" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="جستجوی متن آزاد در توضیحات" Style="{StaticResource FilterGroupBoxStyle}" Tag="{Binding Filters.TextSearchEnabled}">
                        <StackPanel>
                            <CheckBox Content="جستجوی متن آزاد فعال باشد" IsChecked="{Binding Filters.TextSearchEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Text="{Binding Filters.TextSearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Filters.TextSearchEnabled}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter x:Name="FiltersSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderSoftBrush}" ShowsPreview="True" />

            <DataGrid x:Name="TransactionsGrid" Grid.Column="2" ItemsSource="{Binding FilteredTransactions}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="True" CanUserResizeColumns="True" SelectionMode="Extended"
                      SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0"
                      FlowDirection="RightToLeft" FontFamily="{Binding FontFamilyName}" FontSize="{Binding DisplayFontSize}" CanUserResizeRows="True"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      ToolTip="برای تنظیم ارتفاع یک ردیف، مرز پایین آن را با ماوس بکشید.">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" Width="55" />
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date}" Width="95" />
                    <DataGridTextColumn Header="زمان" Binding="{Binding Time}" Width="70" />
                    <DataGridTemplateColumn Header="نوع تراکنش" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TransactionType}" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4B5563" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeposit}" Value="True"><Setter Property="Foreground" Value="#16803C"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                                <DataTrigger Binding="{Binding IsWithdrawal}" Value="True"><Setter Property="Foreground" Value="#B42318"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="نوع ردیف" Binding="{Binding EntryKind}" Width="85" />
                    <DataGridTextColumn Header="شبا" Binding="{Binding Iban}" Width="150" />
                    <DataGridTextColumn Header="واریز" Binding="{Binding Deposit, StringFormat=N0}" Width="105" />
                    <DataGridTextColumn Header="برداشت" Binding="{Binding Withdrawal, StringFormat=N0}" Width="105" />
                    <DataGridTextColumn Header="مانده" Binding="{Binding Balance, StringFormat=N0}" Width="115" />
                    <DataGridTextColumn Header="شعبه" Binding="{Binding BranchCode}" Width="70" />
                    <DataGridTextColumn Header="کانال" Binding="{Binding Channel}" Width="75" />
                    <DataGridTextColumn Header="حساب مقابل" Binding="{Binding OtherAccount}" Width="150" />
                    <DataGridTextColumn Header="بابت / هدف" Binding="{Binding Purpose}" Width="150" />
                    <DataGridTextColumn Header="پیگیری" Binding="{Binding Tracking}" Width="85" />
                    <DataGridTextColumn Header="شناسه" Binding="{Binding Identifier}" Width="110" />
                    <DataGridTextColumn Header="پیگیری واریز" Binding="{Binding TrackingDeposit}" Width="110" />
                    <DataGridTextColumn Header="واریزکننده/دریافت‌کننده" Binding="{Binding Counterparty}" Width="160" />
                    <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" Width="*">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell"><Setter Property="VerticalContentAlignment" Value="Top" /></Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="None" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="0,1,0,1" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="شرح کامل بانک" Binding="{Binding RawDescription}" Width="350">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell"><Setter Property="VerticalContentAlignment" Value="Top" /></Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="TextTrimming" Value="None" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="0,1,0,1" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4" />
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButtonStyle}" Content="&#xE946;" Click="About_Click"
                        ToolTip="نمایش اطلاعات و نسخه برنامه" AutomationProperties.Name="درباره برنامه" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SettingsStatus}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,4" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
