<Window x:Class="BankStatementViewer.Views.FtpFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب فایل از FTP" Width="650" Height="430" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Tahoma" Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="دانلود و باز کردن" Click="Open_Click" IsDefault="True" MinWidth="120" Margin="3"/>
            <Button Content="انصراف" IsCancel="True" MinWidth="80" Margin="3"/>
        </StackPanel>
        <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نام فایل" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="حجم (بایت)" Binding="{Binding Size, StringFormat=N0}" Width="120"/>
                <DataGridTextColumn Header="آخرین تغییر" Binding="{Binding Modified, StringFormat=yyyy/MM/dd HH:mm}" Width="155"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
