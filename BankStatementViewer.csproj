<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WPF bindings require real culture data; do not use invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Ship only English and Persian satellite resources; culture data itself remains enabled. -->
    <SatelliteResourceLanguages>en;en-US;fa;fa-IR</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>BankStatementViewer</RootNamespace>
    <AssemblyName>BankStatementViewer</AssemblyName>
    <StartupObject>BankStatementViewer.App</StartupObject>
    <ApplicationIcon>040-payoff.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="040-payoff.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
